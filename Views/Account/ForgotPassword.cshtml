@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<section class="single-panel">
    <form class="panel" asp-action="ForgotPassword" method="post">
        <p class="eyebrow">Account recovery</p>
        <h1>Reset your password</h1>
        <p>Enter your email and we will send recovery instructions if the account can be recovered.</p>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="validation"></span>
        <button class="button" type="submit">Send reset link</button>
    </form>
</section>
