@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<section class="single-panel">
    <form class="panel" asp-action="ResetPassword" method="post">
        <p class="eyebrow">Account recovery</p>
        <h1>Choose a new password</h1>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="validation"></span>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="validation"></span>
        <button class="button" type="submit">Set new password</button>
    </form>
</section>
