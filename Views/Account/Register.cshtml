@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="auth-shell">
    <div class="auth-intro">
        <p class="eyebrow">Join Token Eater</p>
        <h1>A sharper workspace starts here.</h1>
        <p>Confirm your email after registration to protect your account.</p>
    </div>
    <form class="panel" asp-action="Register" method="post">
        <h2>Create account</h2>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="validation"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="validation"></span>
        <p class="hint">8+ characters with uppercase, lowercase, number, and symbol.</p>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="validation"></span>
        <button class="button" type="submit">Create account</button>
        <p class="form-foot">Already registered? <a asp-action="Login">Log in</a></p>
    </form>
</section>
